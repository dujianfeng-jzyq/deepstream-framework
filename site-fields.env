# 现场参数清单：首次交互安装时按顺序提问，答案保存在安装目录的 site.env。
# 语法：KEY= 必填；KEY="" 可留空；KEY=值 为默认值。模板中用 ${KEY} 引用。
# 紧邻键上方的注释是提问提示，每行显示为一行：先说是什么，再说格式与何时留空，每项一到两行。
# 键名含 PASSWORD/TOKEN/SECRET 的输入不回显。

# 相机编号，用作消息的 source_id、录像目录名与 RTSP 输出路径 <编号>-out
# 只用字母、数字与 _ . ~ - :
CAMERA_ID=camera0

# 相机的 RTSP 地址，不含口令；相机需要认证时带上用户名：rtsp://user@host/...
# 默认值是本机 MediaMTX 上的测试流
RTSP_URL=rtsp://mediamtx:8554/camera0

# 相机的 RTSP 口令，原样填写；相机不需要认证时留空
RTSP_PASSWORD=""

# Redis 口令，各服务共用；留空则不设口令
REDIS_PASSWORD=""

# MediaMTX 推流口令（用户名 publisher），应用用它推送输出流；观看不需要口令
# 只用字母、数字与 !$()*+.;<=>[]^_-@#&；留空则任何人都能推流，只适合开发环境
MEDIAMTX_PUBLISH_PASSWORD=""

# 本机的局域网 IP，供其他机器用浏览器查看 http://<IP>:8889/<路径>，须固定（静态或 DHCP 保留）
# 保持 127.0.0.1 则只能在本机查看
MEDIAMTX_HOST=127.0.0.1
