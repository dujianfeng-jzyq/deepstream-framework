# 现场参数清单：首次交互安装时按顺序提问，答案保存在安装目录的 site.env。
# 语法：KEY= 必填；KEY="" 可留空；KEY=值 为默认值。紧邻键上方的注释是提问提示。
# 键名含 PASSWORD/TOKEN/SECRET 的输入不回显。模板中用 ${KEY} 引用。

# 相机编号：消息中的 source_id 与录像目录名
CAMERA_ID=camera0

# 相机 RTSP 地址（不要写口令；默认指向本机 MediaMTX，可用 tools/push_sample_video.sh 模拟相机）
RTSP_URL=rtsp://mediamtx:8554/camera0

# RTSP 口令（相机不需要认证时留空；需要时地址必须带用户名 rtsp://user@host/...）
RTSP_PASSWORD=""

# Redis 地址（同一 Compose 工程内使用服务名）
REDIS_HOST=redis

# Redis 口令（默认 Redis 未设置口令）
REDIS_PASSWORD=""
