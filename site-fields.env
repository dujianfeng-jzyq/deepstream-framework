# 现场参数清单：首次交互安装时按顺序提问，答案保存在安装目录的 site.env。
# 语法：KEY= 必填；KEY="" 可留空；KEY=值 为默认值。紧邻键上方的注释是提问提示。
# 键名含 PASSWORD/TOKEN/SECRET 的输入不回显。模板中用 ${KEY} 引用。

# 相机编号：消息中的 source_id 与录像目录名
CAMERA_ID=camera0

# 相机 RTSP 地址（不要写口令；默认指向本工程的 MediaMTX，可用 tools/push_sample_video.sh 模拟相机）
RTSP_URL=rtsp://mediamtx:8554/camera0

# RTSP 口令（原样填写，可含任意字符；相机不需要认证时留空，需要时地址必须带用户名 rtsp://user@host/...）
RTSP_PASSWORD=""

# Redis 口令（留空则不设口令；本工程的 Redis 单元与各服务共用这个口令）
REDIS_PASSWORD=""

# MediaMTX 推流口令（用户名 publisher；应用输出与模拟相机推流都用它，观看不需要口令）。
# 只能用字母、数字与 !$()*+.;<=>[]^_-@#&。留空则 publisher 用任意口令都能推流，只适合开发环境
MEDIAMTX_PUBLISH_PASSWORD=""

# 本机的局域网 IP，只在其他机器用浏览器看 WebRTC（http://<IP>:8889/<路径>）时需要；
# 保持 127.0.0.1 则只能在本机查看（其他机器能打开页面但没有画面）。IP 应固定（静态或 DHCP 保留），
# 不能留空（留空时 WebRTC 在本机也不可用）
MEDIAMTX_HOST=127.0.0.1
