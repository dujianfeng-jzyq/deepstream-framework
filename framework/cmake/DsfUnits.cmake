# 单元登记函数：应用、插件、Python 服务与测试。
# 载荷范围完全由这里的 install 规则决定（apps 镜像只执行 cmake --install）。

include_guard(GLOBAL)

# 是否为单元生成 install 规则（进入载荷），默认 ON。变量按目录作用域继承：框架测试在自己的目录中
# 设为 OFF，在那里生成的模板单元照常编译并登记测试，但不进入载荷。
if(NOT DEFINED DSF_INSTALL)
  set(DSF_INSTALL ON)
endif()

# 递归登记 <dir>/*/CMakeLists.txt，按目录名排序，结果与文件系统遍历顺序无关。
# CONFIGURE_DEPENDS：已有构建目录在 cmake --build 时重新检查，新增或删除的单元随之生效。
function(dsf_add_unit_directories parent)
  file(GLOB _lists CONFIGURE_DEPENDS "${parent}/*/CMakeLists.txt")
  list(SORT _lists)
  foreach(_list IN LISTS _lists)
    get_filename_component(_child "${_list}" DIRECTORY)
    add_subdirectory("${_child}")
  endforeach()
endfunction()

# dsf_add_app(<name> SOURCES ... [LIBRARIES ...] [NO_DEEPSTREAM])
# 创建可执行文件并安装到载荷 bin/。默认需要 SDK：SDK 不可用时跳过并提示；
# 只用普通 GStreamer 的应用加 NO_DEEPSTREAM。同时登记一个 CLI 冒烟测试。
function(dsf_add_app name)
  cmake_parse_arguments(ARG "NO_DEEPSTREAM" "" "SOURCES;LIBRARIES" ${ARGN})
  if(NOT ARG_NO_DEEPSTREAM AND NOT DSF_HAVE_DEEPSTREAM)
    message(STATUS "dsf: skip app ${name} (DeepStream SDK unavailable)")
    return()
  endif()
  add_executable(${name} ${ARG_SOURCES})
  target_link_libraries(${name} PRIVATE dsf::framework ${ARG_LIBRARIES} dsf_warnings)
  if(NOT ARG_NO_DEEPSTREAM)
    target_link_libraries(${name} PRIVATE dsf::ds_meta)
  endif()
  if(DSF_INSTALL)
    install(TARGETS ${name} RUNTIME DESTINATION bin)
  endif()
  if(BUILD_TESTING AND DSF_PYTHON)
    add_test(NAME ${name}_cli
             COMMAND "${DSF_PYTHON}" "${DSF_FRAMEWORK_DIR}/tests/python/app_cli_check.py"
                     "$<TARGET_FILE:${name}>")
  endif()
endfunction()

# dsf_add_plugin(<name> SOURCES ... [OUTPUT_NAME n] [FILES ...])
# 推理自定义库等 SDK 插件：共享库安装到载荷 lib/，FILES（许可证、说明）安装到 share/<name>/。
function(dsf_add_plugin name)
  cmake_parse_arguments(ARG "" "OUTPUT_NAME" "SOURCES;FILES;LIBRARIES" ${ARGN})
  if(NOT DSF_HAVE_DEEPSTREAM)
    message(STATUS "dsf: skip plugin ${name} (DeepStream SDK unavailable)")
    return()
  endif()
  add_library(${name} SHARED ${ARG_SOURCES})
  if(ARG_OUTPUT_NAME)
    set_target_properties(${name} PROPERTIES OUTPUT_NAME ${ARG_OUTPUT_NAME})
  endif()
  target_link_libraries(${name} PRIVATE dsf::deepstream ${ARG_LIBRARIES} dsf_warnings)
  if(DSF_INSTALL)
    install(TARGETS ${name} LIBRARY DESTINATION lib)
    if(ARG_FILES)
      install(FILES ${ARG_FILES} DESTINATION share/${name})
    endif()
  endif()
endfunction()

# dsf_add_python_service(<name> [FILES ...] [REQUIREMENTS file])
# 服务源码安装到载荷 services/<name>/；依赖汇总后由 apps 镜像 pip 安装到 python/。
function(dsf_add_python_service name)
  cmake_parse_arguments(ARG "" "REQUIREMENTS" "FILES" ${ARGN})
  if(NOT ARG_FILES)
    set(ARG_FILES main.py)
  endif()
  if(NOT DSF_INSTALL)
    return()
  endif()
  install(FILES ${ARG_FILES} DESTINATION services/${name}
          PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  if(ARG_REQUIREMENTS)
    get_filename_component(_req "${ARG_REQUIREMENTS}" ABSOLUTE)
    set_property(GLOBAL APPEND PROPERTY DSF_PYTHON_REQUIREMENTS "${_req}")
  endif()
endfunction()

# dsf_add_test(<name> SOURCES ... [LIBRARIES ...] [TIMEOUT s])
function(dsf_add_test name)
  cmake_parse_arguments(ARG "" "TIMEOUT" "SOURCES;LIBRARIES;INCLUDES" ${ARGN})
  if(NOT BUILD_TESTING)
    return()
  endif()
  add_executable(${name} ${ARG_SOURCES})
  target_include_directories(${name} PRIVATE "${DSF_FRAMEWORK_DIR}/tests/cpp" ${ARG_INCLUDES})
  target_link_libraries(${name} PRIVATE ${ARG_LIBRARIES} dsf_warnings)
  add_test(NAME ${name} COMMAND ${name})
  if(ARG_TIMEOUT)
    set_tests_properties(${name} PROPERTIES TIMEOUT ${ARG_TIMEOUT})
  endif()
endfunction()

# dsf_add_python_test(<name> <script> [ARGS ...])
function(dsf_add_python_test name script)
  cmake_parse_arguments(ARG "" "TIMEOUT" "ARGS" ${ARGN})
  if(NOT BUILD_TESTING OR NOT DSF_PYTHON)
    return()
  endif()
  get_filename_component(_script "${script}" ABSOLUTE)
  # 经 run_unittest.py 运行：DSF_FORBID_SKIPS=1 时 SKIP 计为失败。
  add_test(NAME ${name} COMMAND "${DSF_PYTHON}" "${DSF_FRAMEWORK_DIR}/tests/python/run_unittest.py"
           "${_script}" ${ARG_ARGS})
  set_tests_properties(${name} PROPERTIES
    ENVIRONMENT "PYTHONPATH=${DSF_FRAMEWORK_DIR}/python:${DSF_FRAMEWORK_DIR}/deploy:${DSF_FRAMEWORK_DIR}/tests/python;PYTHONDONTWRITEBYTECODE=1")
  if(ARG_TIMEOUT)
    set_tests_properties(${name} PROPERTIES TIMEOUT ${ARG_TIMEOUT})
  endif()
endfunction()

# 所有单元登记完成后调用：生成汇总的 Python 依赖清单，供 apps 镜像安装。
function(dsf_finalize)
  get_property(_reqs GLOBAL PROPERTY DSF_PYTHON_REQUIREMENTS)
  set(_content "# GENERATED by CMake from the Python service units\n")
  foreach(_req IN LISTS _reqs)
    file(READ "${_req}" _text)
    string(APPEND _content "# ${_req}\n${_text}\n")
    set_property(DIRECTORY "${CMAKE_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_req}")
  endforeach()
  file(WRITE "${CMAKE_BINARY_DIR}/python-requirements.txt" "${_content}")
endfunction()
