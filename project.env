# 项目公共输入：身份、版本、上游镜像与默认值。平台差异写在 profiles/，现场答案在 site.env。

# 项目名：决定镜像名、Compose 工程名（容器、网络、卷）与默认安装目录。
PROJECT_NAME=deepstream-framework

# base 的上游镜像（DEEPSTREAM_IMAGE）不在这里设默认值：每个 profile 在 x-build 中写明自己的镜像，
# DeepStream 版本从 tag 解析。这样每个 profile 的版本都显式可见，安装时总能与发布包核对。

# 载荷（apps）与运行环境（base）分别发版。base 的 tag 另带构建输入摘要，输入变化必然换 tag。
APPS_VERSION=0.1.0
BASE_VERSION=0.1.0

# base 额外安装的运行依赖（空格分隔的 apt 包名），供本项目的服务使用。
BASE_APT_PACKAGES=

# pip 源；空表示官方 PyPI。
PIP_INDEX_URL=

# 宿主机数据目录，挂载到容器 /data；空表示 ~/<PROJECT_NAME>/data。~ 在运行机器上展开，必须位于安装目录之外。
HOST_DATA_PATH=

# 安装根目录；空表示 ${XDG_DATA_HOME:-~/.local/share}，安装到 <根>/<PROJECT_NAME>。
INSTALL_ROOT=

# 依赖镜像：所有非空的 *_IMAGE 都随包发布，目标机不联网拉取。删除一行即不再依赖该镜像。
REDIS_IMAGE=redis:7.4.2-alpine
MEDIAMTX_IMAGE=bluenviron/mediamtx:1.15.3
